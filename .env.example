# ===========================================
# FlashDev API — Environment Variables
# ===========================================
# Copy file nay thanh .env va dien gia tri that:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# Luu y: KHONG commit file .env len Git.

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/flashdev
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flashdev
MONGODB_URI=mongodb://127.0.0.1:27017/flashdev

# Port API chay (mac dinh: 3000)
PORT=3000

# ===========================================
# CORS Configuration
# ===========================================
# Danh sach origins duoc phep truy cap API, phan cach bang dau phay
# Vi du: http://localhost:3000,https://flashdev.local,https://flashdev.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
